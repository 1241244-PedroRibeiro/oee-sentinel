@page "/"
@inject IListMachinesHandler MachinesHandler

<PageTitle>OEE Sentinel - Dashboard</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">OEE Sentinel Dashboard</h1>
    
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Active Production Machines</h4>
        </div>
        <div class="card-body">
            @if (machines == null)
            {
                <p><em>Loading machines from database...</em></p>
            }
            else if (!machines.Any())
            {
                <p>No active machines found.</p>
            }
            else
            {
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Ideal Cycle (s)</th>
                            <th>Planned Shift (h)</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var machine in machines)
                        {
                            <tr>
                                <td><strong>@machine.Code</strong></td>
                                <td>@machine.Name</td>
                                <td>@machine.IdealCycleSeconds s</td>
                                <td>@(machine.PlannedShiftSeconds / 3600) h</td>
                                <td>
                                    <span class="badge bg-success">Active</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<MachineDto>? machines;

    protected override async Task OnInitializedAsync()
    {
        // Chamada in-process ao Handler (sem passar pelo HTTP)
        machines = await MachinesHandler.HandleAsync(new ListMachinesQuery());
    }
}
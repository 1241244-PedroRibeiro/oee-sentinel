# PostgreSQL Database
POSTGRES_USER=oee
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=oee_sentinel

# Connection String (used by EF Core)
# Note: For local development outside Docker, use localhost. Inside Docker network, use 'postgres'.
ConnectionStrings__Default=Host=localhost;Database=oee_sentinel;Username=oee;Password=change_me_in_local_env

# App Settings
ASPNETCORE_ENVIRONMENT=Development
SeedData__Enabled=true